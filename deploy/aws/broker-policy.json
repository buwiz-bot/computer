{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEc2InSingapore",
      "Effect": "Allow",
      "Action": ["ec2:Describe*", "ec2:GetConsoleOutput"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-southeast-1"}}
    },
    {
      "Sid": "LaunchOnlyTaggedComputers",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": ["arn:aws:ec2:ap-southeast-1:*:instance/*", "arn:aws:ec2:ap-southeast-1:*:volume/*"],
      "Condition": {"StringEquals": {"aws:RequestTag/buwiz:managed": "true"}}
    },
    {
      "Sid": "LaunchFromOurTemplateAndNetwork",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:ap-southeast-1:*:launch-template/*",
        "arn:aws:ec2:ap-southeast-1:*:subnet/*",
        "arn:aws:ec2:ap-southeast-1:*:security-group/*",
        "arn:aws:ec2:ap-southeast-1:*:network-interface/*",
        "arn:aws:ec2:ap-southeast-1:*:key-pair/*",
        "arn:aws:ec2:ap-southeast-1::image/*"
      ]
    },
    {
      "Sid": "TagOnlyAtLaunch",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": ["arn:aws:ec2:ap-southeast-1:*:instance/*", "arn:aws:ec2:ap-southeast-1:*:volume/*"],
      "Condition": {"StringEquals": {"ec2:CreateAction": "RunInstances"}}
    },
    {
      "Sid": "LifecycleOfOurComputersOnly",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:StopInstances", "ec2:TerminateInstances", "ec2:RebootInstances"],
      "Resource": "arn:aws:ec2:ap-southeast-1:*:instance/*",
      "Condition": {"StringEquals": {"ec2:ResourceTag/buwiz:managed": "true"}}
    },
    {
      "Sid": "PassOnlyTheComputerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::099840429070:role/buwiz-computer*",
      "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}
    }
  ]
}
