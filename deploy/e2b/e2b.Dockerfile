FROM ghcr.io/buwiz-bot/computer:latest
USER root
RUN mkdir -p /run/buwiz && chown box /run/buwiz && chmod 0700 /run/buwiz
ENV BOX_TOKEN_FILE=/run/buwiz/token
ENV BOX_VIEWER_PASSWORD_FILE=/run/buwiz/viewer
ENV WORKSPACE_ROOT=/workspace
ENV TINI_SUBREAPER=1
ENV BOX_ID=buwiz-computer
ENV RUST_LOG=info
ENV BOX_DESKTOP=1
ENV BOX_DESKTOP_REQUIRED=1
ENV BOX_DISPLAY=:1
ENV BOX_DISPLAY_GEOM=1280x800x24
ENV BOX_CHROME=1
ENV BOX_CHROME_PROFILE=/home/box/desktops/main/chrome-profile
ENV BOX_CUA=1
ENV BOX_EXEC_BIND=0.0.0.0:1337
ENV BOX_HOST_BIND=0.0.0.0:1340
ENV BOX_MAX_CONCURRENT_EXECS=8
ENV BOX_EGRESS_TUNNEL=0
ENV BOX_EGRESS_WS_BIND=0.0.0.0:8790
ENV BOX_EGRESS_PROXY_BIND=127.0.0.1:8791
ENV BOX_EGRESS_ADMIN_BIND=127.0.0.1:8792
WORKDIR /workspace
