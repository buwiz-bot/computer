# Shared bearer token for box-exec, CUA, and box-host unless BOX_HOST_TOKEN is set.
# Required, at least 16 characters. Do not use dev-box-token. Generate one:
#   openssl rand -base64 32
# Startup refuses this placeholder (anything containing "replace-with"), even with
# BOX_ALLOW_INSECURE_DEV=1. Change it before you run write-secrets.sh.
#
# Compose does not pass this into the container. `scripts/write-secrets.sh`
# copies it into ./secrets/box_token and Compose mounts that read-only at
# /run/secrets/box_token, because a value in the container environment stays
# readable in /proc/1/environ and in `docker inspect`. See README §Auth.
BOX_TOKEN=replace-with-a-long-random-token

# Optional separate token for box-host. When set it replaces BOX_TOKEN on every box-host route
# except /v1/health (/v1/ready included); box-exec keeps BOX_TOKEN. Defaults to BOX_TOKEN.
# BOX_HOST_TOKEN=

# Paths to files holding the secrets, for anything that starts the image
# directly instead of through Compose. These win over the value forms.
# BOX_TOKEN_FILE=/run/secrets/box_token
# BOX_HOST_TOKEN_FILE=/run/secrets/box_host_token
# BOX_VIEWER_PASSWORD_FILE=/run/secrets/box_viewer_password
# BOX_EGRESS_TUNNEL_BEARER_FILE=/run/secrets/box_egress_tunnel_bearer

# Independent viewer password. Required when the desktop is on, at least 16 characters. Must not be
# derived from BOX_TOKEN. voxl (6901-6905) asks for it; the loopback publish is the other control.
# Generate one: openssl rand -base64 24
# Like BOX_TOKEN, the "replace-with" placeholder is refused, and BOX_ALLOW_INSECURE_DEV does not
# cover this one at all.
BOX_VIEWER_PASSWORD=replace-with-a-long-random-password

# Stable id reported by box-host. Defaults to HOSTNAME or "buwiz-computer".
BOX_ID=local-dev

# Jail root for exec cwd + file APIs. Inside the image this is /workspace.
# WORKSPACE_ROOT=/workspace

# Bind addresses. Rust/native default is 127.0.0.1. The guest image listens on
# 0.0.0.0 *inside* the container so Compose port-map works. Host publish is 127.0.0.1.
# BOX_EXEC_BIND=0.0.0.0:1337
# BOX_HOST_BIND=0.0.0.0:1340
# A bind or a number below that does not parse stops startup; it is not replaced by a default.

# URL box-host uses to probe box-exec readiness (container-local; not an SDK connect URL).
# BOX_EXEC_URL=http://127.0.0.1:1337

# Optional browser origin allowlist for guest CORS. Empty = no browser origins. "*" is ignored.
# BOX_CORS_ORIGINS=

# Allow well-known/short BOX_TOKEN only when both daemon binds are loopback (native runner).
# Never set this on a VM that publishes 0.0.0.0.
# BOX_ALLOW_INSECURE_DEV=1

# Desktop / CUA
# BOX_DESKTOP=1
# BOX_DESKTOP_REQUIRED=1
# BOX_DISPLAY=:1
# BOX_DISPLAY_GEOM=1280x800x24

# Chromium
# BOX_CHROME=1
# BOX_CHROME_PROFILE=/home/box/desktops/main/chrome-profile

# Computer Use actuators on box-exec
# BOX_CUA=1

# Laptop Chromium egress (off). Production: see docs/EGRESS.md. Never publish 8791.
# BOX_EGRESS_TUNNEL=0
# BOX_EGRESS_TUNNEL_BEARER=   # prefer BOX_EGRESS_TUNNEL_BEARER_FILE; write-secrets.sh copies it
# BOX_EGRESS_TUNNEL_BEARER_FILE=/run/secrets/box_egress_tunnel_bearer
# BOX_EGRESS_RELAY_HOSTS=
# Read by the laptop client, which dials only public addresses (every relay is checked):
# BOX_EGRESS_RELAY_PORTS=80,443     # "*" is any port
# BOX_EGRESS_ALLOW_PRIVATE=1        # lets it dial loopback and LAN addresses. Leave it off.

# Max simultaneous POST /v1/exec (and stream/detach). Extra calls → 429 busy.
# BOX_MAX_CONCURRENT_EXECS=8

# After exec timeout: SIGTERM, then SIGKILL after this many ms.
# BOX_EXEC_KILL_GRACE_MS=2000

# Directory listing cap (GET /v1/files). truncated=true if hit.
# BOX_MAX_DIR_ENTRIES=4096

RUST_LOG=info
