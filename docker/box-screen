#!/bin/bash
# A Bot's own screen on a computer several Bots share.
#
# The box's own screen (BOX_DISPLAY, :1) is its main one. Every Bot on a computer several Bots
# share gets a slot here: its own X display with the same desktop as the main screen (an xfce
# session: wallpaper, and the dock whose Chromium is this Bot's), a voxl on port 6900+N, and a
# Chromium of its own, with its own profile (so what it signs in to stays its own) that the
# server starts on that display when the Bot opens a page (`box-chromium` with this screen's
# BOX_DISPLAY and BOX_CHROME_PROFILE). The entrypoint's viewer keeper holds the password and
# starts the voxl; this script only names the display.
#
#   box-screen up <bot>     start the Bot's screen (or find it running); prints its slot as JSON
#   box-screen down <bot>   stop it; its slot and its profile are kept for the next `up`
#   box-screen list         every Bot's slot, and whether its screen is running
#
# Slots are kept in the home volume, so a Bot keeps its display number and profile across
# restarts and updates; the screens themselves start again on the next `up`.
set -euo pipefail

MAX_SCREENS="${BOX_MAX_OWN_SCREENS:-4}"
FIRST_SLOT=2
HOME_DIR="${HOME:-/home/box}"
SLOTS_DIR="${HOME_DIR}/.box-screens"
VIEWER_CTL="${BOX_VIEWER_CTL:-/tmp/box-viewer.ctl}"
VIEWER_PORT_BASE=6900
PROFILES_DIR="${BOX_CHROME_PROFILE:-${HOME_DIR}/chrome-profile}/bots"
# What a Bot makes on its screen goes in a folder of its own, kept across `down` like its profile,
# so it can be collected per agent. The shared screen's is ${WORKSPACE_ROOT}/shared.
AGENTS_DIR="${WORKSPACE_ROOT:-/workspace}/agents"
GEOM="${BOX_DISPLAY_GEOM:-1280x800x24}"

die() {
  printf '{"error":"%s"}\n' "$1"
  exit 1
}

bot="${2:-}"
case "${1:-}" in
  up | down)
    # A Bot id names a directory and a profile: letters, digits, `_` and `-` only.
    [[ "${bot}" =~ ^[A-Za-z0-9_-]{1,80}$ ]] || die "a Bot id is letters, digits, _ and - only"
    ;;
  list) ;;
  *) die "usage: box-screen up|down <bot> | list" ;;
esac

mkdir -p "${SLOTS_DIR}" "${PROFILES_DIR}"
# One box-screen at a time. What it starts must not inherit the lock (`9>&-` below): an X server
# holding it would make every later box-screen wait for good.
exec 9>"/tmp/box-screen.lock"
flock 9

running() {
  [[ -S "/tmp/.X11-unix/X$1" ]] && pgrep -f "^Xvfb :$1 " >/dev/null
}

# The xfce session on display :$1. Every screen's session is the same command, so it is told apart
# by the DISPLAY it was started with.
sessions_on() {
  local p
  for p in $(pgrep -x xfce4-session); do
    tr '\0' '\n' <"/proc/${p}/environ" 2>/dev/null | grep -qx "DISPLAY=:$1" && echo "${p}"
  done
  return 0
}

# Ask the viewer keeper to start or stop the voxl of display $2. The keeper holds the fifo open,
# so this write never blocks.
viewer() {
  [[ -p "${VIEWER_CTL}" ]] || die "this computer has no viewer"
  printf '%s %s\n' "$1" "$2" >"${VIEWER_CTL}"
}

slot_of() {
  [[ -f "${SLOTS_DIR}/$1" ]] && cat "${SLOTS_DIR}/$1"
}

allocate() {
  local taken n
  taken=" $(cat "${SLOTS_DIR}"/* 2>/dev/null | tr '\n' ' ') "
  for ((n = FIRST_SLOT; n < FIRST_SLOT + MAX_SCREENS; n++)); do
    if [[ "${taken}" != *" ${n} "* ]]; then
      echo "${n}" >"${SLOTS_DIR}/$1"
      echo "${n}"
      return
    fi
  done
  return 1
}

if [[ "$1" == "list" ]]; then
  printf '{"screens":['
  sep=""
  for f in "${SLOTS_DIR}"/*; do
    [[ -f "${f}" ]] || continue
    n="$(cat "${f}")"
    up=false
    running "${n}" && up=true
    printf '%s{"bot":"%s","slot":%s,"display":":%s","viewer_port":%s,"workspace":"agents/%s","running":%s}' \
      "${sep}" "$(basename "${f}")" "${n}" "${n}" "$((VIEWER_PORT_BASE + n))" "$(basename "${f}")" "${up}"
    sep=","
  done
  printf ']}\n'
  exit 0
fi

profile="${PROFILES_DIR}/${bot}"

if [[ "$1" == "down" ]]; then
  n="$(slot_of "${bot}")" || { printf '{"bot":"%s","running":false}\n' "${bot}"; exit 0; }
  pkill -f -- "--user-data-dir=${profile}( |$)" 2>/dev/null || true
  viewer down "${n}"
  for p in $(sessions_on "${n}"); do kill "${p}" 2>/dev/null || true; done
  pkill -f "^Xvfb :${n} " 2>/dev/null || true
  printf '{"bot":"%s","slot":%s,"display":":%s","viewer_port":%s,"running":false}\n' \
    "${bot}" "${n}" "${n}" "$((VIEWER_PORT_BASE + n))"
  exit 0
fi

# up
n="$(slot_of "${bot}")" || n="$(allocate "${bot}")" ||
  die "this computer already runs ${MAX_SCREENS} Bots' own screens; switch one back to the shared screen first"
agent_dir="${AGENTS_DIR}/${bot}"
mkdir -p "${profile}" "${agent_dir}"

if ! running "${n}"; then
  # A screen stopped by a restart leaves its lock and socket in /tmp; nothing else starts an X
  # server on this number, so both are stale here.
  rm -f "/tmp/.X${n}-lock" "/tmp/.X11-unix/X${n}"
  setsid -f Xvfb ":${n}" -screen 0 "${GEOM}" -ac -shmem +extension GLX +extension XTEST \
    +extension DAMAGE +render -noreset >"/tmp/xvfb-${n}.log" 2>&1 9>&-
  for _ in $(seq 50); do
    [[ -S "/tmp/.X11-unix/X${n}" ]] && break
    sleep 0.1
  done
  [[ -S "/tmp/.X11-unix/X${n}" ]] || die "the screen's X server did not start"
fi

# The main screen's desktop (entrypoint.sh): xfce4-session brings up xfwm4, xfdesktop (the
# wallpaper) and the panel (the dock), over a session bus of their own. Without it the screen is
# plain black until the Bot opens a page, and black again once it closes its browser. The dock's
# Chromium launcher is box-chromium, which opens on BOX_DISPLAY with BOX_CHROME_PROFILE: this
# Bot's browser on this screen, from the session's environment.
if [[ -z "$(sessions_on "${n}")" ]]; then
  # The session starts in the Bot's folder, so a terminal from its dock opens there.
  cd "${agent_dir}"
  runtime="/tmp/runtime-box-${n}"
  mkdir -p "${runtime}"
  chmod 700 "${runtime}"
  DISPLAY=":${n}" BOX_DISPLAY=":${n}" BOX_CHROME_PROFILE="${profile}" XDG_RUNTIME_DIR="${runtime}" \
    XDG_CONFIG_HOME="${HOME_DIR}/.config" \
    setsid -f dbus-launch --exit-with-session xfce4-session >"/tmp/xfce4-session-${n}.log" 2>&1 9>&-
fi

viewer up "${n}"
# A caller opens the screen as soon as this prints, so it waits for voxl to take connections.
for _ in $(seq 50); do
  curl -fsS -o /dev/null "http://127.0.0.1:$((VIEWER_PORT_BASE + n))/healthz" 2>/dev/null && break
  sleep 0.1
done

# A profile kept from an older extension runs its old background script (see
# box-refresh-extension); this Bot's Chromium is not running yet when the screen first comes up.
if ! pgrep -f -- "--user-data-dir=${profile}( |$)" >/dev/null; then
  BOX_CHROME_PROFILE="${profile}" BOX_SCREEN_WORKSPACE="${agent_dir}" \
    /usr/local/bin/box-refresh-extension >/dev/null
fi

printf '{"bot":"%s","slot":%s,"display":":%s","viewer_port":%s,"workspace":"agents/%s","profile":"%s","running":true}\n' \
  "${bot}" "${n}" "${n}" "$((VIEWER_PORT_BASE + n))" "${bot}" "${profile}"
