#!/bin/sh
# The dock's Chromium. Same profile as the Chromium the entrypoint starts
# (BOX_CHROME=1), so this opens a window in that instance; with no instance
# running it starts one. A desktop's user has no setuid sandbox in this image, hence
# --no-sandbox, and --test-type hides the banner about it. --force-renderer-accessibility puts its
# buttons and pages on the screen's accessibility bus (POST /v1/cua/tree), as the entrypoint's does.
#
# When BOX_EGRESS_TUNNEL is on, pass the same CONNECT proxy flags as the
# entrypoint so a cold start (no running instance) still exits via the laptop.

# flag_on VALUE [DEFAULT]: the box's on/off rule, the same as the entrypoint's and the daemons'.
# shellcheck source-path=SCRIPTDIR source=box-flag.sh
. /usr/lib/box/flag.sh

proxy_server=""
proxy_bypass=""
proxy_webrtc=""
# The entrypoint records the proxy port when it starts the tunnel, so a launch
# from a shell that did not inherit BOX_EGRESS_TUNNEL still goes through the
# proxy rather than quietly out of the VM.
port_file="/run/box/egress/port"
port="${BOX_EGRESS_PROXY_PORT:-}"
# An unset or blank BOX_EGRESS_TUNNEL is on when that port file is there, else off.
tunnel_default=0
if [ -r "${port_file}" ]; then tunnel_default=1; fi
if [ -z "${port}" ] && [ -r "${port_file}" ]; then port="$(cat "${port_file}")"; fi
if flag_on "${BOX_EGRESS_TUNNEL:-}" "${tunnel_default}"; then
  if [ -z "${port}" ]; then
    echo "box-chromium: the egress tunnel is on but its proxy port is unknown; refusing to start unproxied" >&2
    exit 1
  fi
  proxy_server="--proxy-server=http://127.0.0.1:${port}"
  proxy_bypass="--proxy-bypass-list=localhost;127.0.0.1;[::1];<-loopback>"
  proxy_webrtc="--force-webrtc-ip-handling-policy=disable_non_proxied_udp"
fi
# The screen to open on: a Bot's own screen (box-screen) is passed as BOX_DISPLAY with its own
# BOX_CHROME_PROFILE; otherwise the box's own, as before. The window fills that screen.
export DISPLAY="${BOX_DISPLAY:-${DISPLAY:-:1}}"
geom="${BOX_DISPLAY_GEOM:-1280x800x24}"
win_w="${geom%%x*}"
rest="${geom#*x}"
win_h="${rest%%x*}"
# A DevTools pipe whose other end only box-exec gets (box-chrome-pipe, docs/USERS.md), when this
# starts the screen's browser: if Chromium is already running on the profile, the launcher sees its
# pipe is taken and this just opens a window in it. BOX_BROWSER=0 starts it with no pipe.
launcher=""
if flag_on "${BOX_BROWSER:-}" 1; then
  if [ -n "${BOX_SCREEN_RUN:-}" ] && [ -x /usr/local/bin/box-chrome-pipe ]; then
    launcher="/usr/local/bin/box-chrome-pipe ${BOX_SCREEN_RUN}/cdp.sock --"
  fi
fi
# shellcheck disable=SC2086 # the launcher's words, like the proxy flags, are split on purpose
exec ${launcher} chromium \
  --user-data-dir="${BOX_CHROME_PROFILE:-${HOME}/chrome-profile}" \
  --window-size="${win_w},${win_h}" \
  --window-position=0,0 \
  --no-first-run \
  --no-default-browser-check \
  --disable-dev-shm-usage \
  --disable-gpu \
  --no-sandbox \
  --test-type \
  --hide-crash-restore-bubble \
  --disable-session-crashed-bubble \
  --disable-features=Translate \
  --load-extension=/opt/box/active-tab \
  --force-renderer-accessibility \
  ${proxy_server} \
  ${proxy_bypass} \
  ${proxy_webrtc} \
  "$@"
